// Archivo de recursos de Windows para Screen Highlighter
// Icono principal de la aplicación

IDI_ICON1 ICON "misc01.ico"

// Información de versión
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Unnamed10110"
            VALUE "FileDescription", "Screen Highlighter - Screen Capture and Annotation Tool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ScreenHighlighter.exe"
            VALUE "LegalCopyright", "Copyright (C) 2025 Unnamed10110"
            VALUE "OriginalFilename", "ScreenHighlighter.exe"
            VALUE "ProductName", "Screen Highlighter"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
