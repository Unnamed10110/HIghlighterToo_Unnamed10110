# Configuración de valores por defecto para Screen Highlighter
set(overlay_opacity 128)
set(zoom_min_factor 50)
set(zoom_max_factor 300)
set(text_cursor_blink_speed 500)
set(region_border_thickness 2)
# COLORREF es 0x00BBGGRR, no 0x00RRGGBB: 16711680 == 0xFF0000 == azul, no rojo.
# Se usa 65280 == 0x00FF00 == verde, que es el valor por defecto del codigo.
set(region_border_color 65280)
set(hotkey_shift_alt_x 1)
