# Screen Highlighter Configuration File
# Generated automatically - Do not edit manually

# Configuración de opacidad del overlay (0-255)
overlay_opacity=@overlay_opacity@

# Factor de zoom mínimo (10-500)
zoom_min_factor=@zoom_min_factor@

# Factor de zoom máximo (50-1000)
zoom_max_factor=@zoom_max_factor@

# Velocidad de parpadeo del cursor de texto (ms)
text_cursor_blink_speed=@text_cursor_blink_speed@

# Grosor del borde de las regiones (1-10)
region_border_thickness=@region_border_thickness@

# Color del borde de las regiones (RGB)
region_border_color=@region_border_color@

# Habilitar hotkey Shift+Alt+X (1=habilitado, 0=deshabilitado)
hotkey_shift_alt_x=@hotkey_shift_alt_x@

# Opacidad del resaltador (1-255)
highlighter_alpha=110

# Color de dibujo (COLORREF: 0x00BBGGRR)
drawing_color=255

# Grosor de linea (1-50)
drawing_thickness=3

# Relleno de las formas (1=si, 0=no)
drawing_fill=0

# Formato de guardado de capturas: png (por defecto) o bmp
screenshot_format=png

# Carpeta de guardado. Vacio = %USERPROFILE%\Pictures\Screenshots
screenshot_folder=

# Auto-inicio con Windows (tarea programada "Screen Highlighter").
# La aplicacion se registra sola en cada arranque; poner 1 aqui, o usar
# "Disable Auto-Start" en el menu del tray, hace que deje de hacerlo.
autostart_user_disabled=0

# Leyenda de atajos en el overlay (1=visible, 0=oculta). Se alterna con F9.
show_shortcut_legend=1

# Atajos de las herramientas de dibujo. Se admite una letra o digito ("A", "7")
# o una tecla de funcion ("F1".."F24"). Si el valor no es valido se conserva el
# que trae la aplicacion.
#
# Ojo: al ser letras sueltas, dentro del modo texto (Ctrl+T) no actuan como
# atajo, porque ahi se escriben. Las teclas de funcion si siguen actuando.
hotkey_arrow=A
hotkey_line=L
hotkey_rectangle=R
hotkey_highlight=H
hotkey_pixelate=B
hotkey_step_number=S
hotkey_ellipse=E
hotkey_pen=P

# Tecla que, combinada con Ctrl, entra en modo texto.
hotkey_text=T

# Tecla que muestra u oculta la leyenda de atajos del overlay.
hotkey_toggle_legend=F9
